        "license": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "review": {
      "type": "object",
      "required": [
        "status",
        "reviewer"
      ],
      "properties": {
        "status": {
          "enum": [
            "reviewed",
            "verified_auto"
          ]
        },
        "reviewer": {
