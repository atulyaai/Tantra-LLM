# Python
__pycache__/
*.py[cod]
*$py.class
*.so
env/
venv/
.venv/

# Testing
.pytest_cache/
.benchmarks/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Large binary checkpoints (use releases for these)
[Mm]odel/checkpoint_*.pt
[Mm]odel/checkpoint_*.dna
[Mm]odel/converted_*.pt
[Mm]odel/corpus_sample.txt
[Mm]odel/training_status.json
[Mm]odel/Best/*.pt
[Mm]odel/Checkpoints/*.pt
[Mm]odel/Latest/*.pt
# Any checkpoint subfolder (e.g. Model/MoE2_32K/checkpoint_*.pt)
Model/**/checkpoint_*.pt
Model/**/checkpoint_*.dna
Model/**/*.tmp

# Generated checkpoint sidecar metadata (written by save_checkpoint)
Model/**/*.pt.meta.json

# Regenerated expert artifacts (built by training runs)
Model/Experts/*.dna
Model/Experts/registry.json

# Raw training data (too large for GitHub). Category folders are kept as
# lightweight prototypes (README.md) on GitHub; the actual *.jsonl stay local.
# Datasets: master_train.jsonl stays local (822MB), staged_master.jsonl & manifest.json tracked on git
Datasets/*.jsonl
Datasets/**/*.jsonl
!Datasets/manifest.json
!Datasets/staged_master.jsonl
!Datasets/curated_seeds/*.jsonl
!Datasets/curated_seeds/**/*.jsonl
!Datasets/curated_sft/*.jsonl
!Datasets/curated_sft/**/*.jsonl
!Datasets/seeds/*.jsonl
!Datasets/seeds/**/*.jsonl
!Model/sample_model.pt
Model/memory_bank.json
Model/saved_chats.json
Model/tokenizer.pt
*.parquet
*.h5

# Logs
*.log
logs/
reports/

# Secrets
.env
.env.*
*.pem
*.key
secrets/
tmp_*.json

# IDE & OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
